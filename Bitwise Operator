typedef struct {
    int key;
    UT_hash_handle hh;
} HashItem;

void freeHash(HashItem** set) {
    HashItem *curr, *tmp;
    HASH_ITER(hh, *set, curr, tmp) {
        HASH_DEL(*set, curr);
        free(curr);
    }
}

int subarrayBitwiseORs(int* arr, int arrSize) {
    HashItem *res = NULL, *prev = NULL;
    
    for (int i = 0; i < arrSize; ++i) {
        HashItem *curr = NULL;
        HashItem *tmp = NULL;
        int val = arr[i];

        HashItem *entry = (HashItem*)malloc(sizeof(HashItem));
