int minReorder(int n, int** connections, int connectionsSize, int* connectionsColSize) {
    typedef struct {
        int to;
        int is_original;
    } Edge;

    int* deg = (int*)calloc(n, sizeof(int));
    for (int i = 0; i < connectionsSize; i++) {
        deg[connections[i][0]]++;
        deg[connections[i][1]]++;
    }

    int* head = (int*)malloc((n + 1) * sizeof(int));
    head[0] = 0;
    for (int i = 0; i < n; i++) {
        head[i + 1] = head[i] + deg[i];
    }

    Edge* edges = (Edge*)malloc(2 * connectionsSize * sizeof(Edge));
    int* curr_pos = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        curr_pos[i] = head[i];
    }

    for (int i = 0; i < connectionsSize; i++) {
        int u = connections[i][0];
        int v = connections[i][1];

        edges[curr_pos[u]].to = v;
        edges[curr_pos[u]].is_original = 1;
        curr_pos[u]++;

        edges[curr_pos[v]].to = u;
        edges[curr_pos[v]].is_original = 0;
        curr_pos[v]++;
    }

    int* queue = (int*)malloc(n * sizeof(int));
    bool* visited = (bool*)calloc(n, sizeof(bool));
    int front = 0, rear = 0;
    int reorder_count = 0;

    queue[rear++] = 0;
    visited[0] = true;

    while (front < rear) {
        int curr = queue[front++];

        for (int i = head[curr]; i < head[curr + 1]; i++) {
            int neighbor = edges[i].to;
            if (!visited[neighbor]) {
                if (edges[i].is_original == 1) {
                    reorder_count++;
                }
                visited[neighbor] = true;
                queue[rear++] = neighbor;
            }
        }
    }

    free(deg);
    free(head);
    free(edges);
    free(curr_pos);
    free(queue);
    free(visited);

    return reorder_count;
}
